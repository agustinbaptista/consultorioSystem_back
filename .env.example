# Supabase PostgreSQL (usar Session pooler :5432 o conexión directa para TypeORM)
DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL_DIRECT=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DB_AUTO_INIT=true

# Supabase (referencia frontend / integraciones futuras)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Microservicios
JWT_SECRET=change-me-dev-secret-min-32-chars-long
INTERNAL_API_KEY=internal-dev-key
NODE_ENV=development
TZ=America/Argentina/Buenos_Aires

AUTH_SERVICE_URL=http://localhost:3001
EMPLOYEES_SERVICE_URL=http://localhost:3002
PATIENTS_SERVICE_URL=http://localhost:3003
APPOINTMENTS_SERVICE_URL=http://localhost:3004
PROFESSIONALS_SERVICE_URL=http://localhost:8000
CORS_ORIGIN=http://localhost:3000
